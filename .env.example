# Copy this file to .env and put your real values there.
# .env is git-ignored and never committed; this template is committed.

# Required. An Anthropic API key from the Anthropic Console (first needed in Lab 0.3).
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional. A DeepSeek API key; only the data generator (Lab 0.3) uses it.
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# Optional. One of DEBUG, INFO, WARNING, ERROR. Default: INFO
LOG_LEVEL=INFO

# Optional. One of local, ci, production. Default: local
ENVIRONMENT=local
